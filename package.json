{
  "name": "@flowpact/core",
  "version": "0.12.0",
  "private": true,
  "description": "Workflow model for flowpact: YAML to IR, expression analysis, matrix expansion and the data-flow graph.",
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --clean --target node22",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@actions/expressions": "^0.3.61",
    "@actions/workflow-parser": "^0.3.61",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
