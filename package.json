{
  "name": "@ciatlas/core",
  "version": "2.0.0",
  "private": true,
  "description": "The GitHub Actions workflow model: YAML to IR, expression analysis, matrix expansion and the data-flow graph.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ciatlas/core.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./src/index.ts"
    }
